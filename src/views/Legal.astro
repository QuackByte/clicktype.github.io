---
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { owner } from '../config';
import { href, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const mail = `mailto:${owner.email}`;
---
{lang === 'en' ? (
<Base lang="en" route="legal" title="Legal notice | ClickType" description="Owner details for this website, as required by Spanish law (LSSI-CE).">
  <Prose title="Legal notice" intro="Information about the owner of this website, as required by Article 10 of Spanish Law 34/2002 (LSSI-CE).">
    <dl>
      <dt>Owner</dt><dd>{owner.legalName}</dd>
      <dt>Trading name</dt><dd>{owner.brand}</dd>
      <dt>Tax ID (NIF)</dt><dd>{owner.taxId}</dd>
      <dt>Address</dt><dd>{owner.address}</dd>
      <dt>Email</dt><dd><a href={mail}>{owner.email}</a></dd>
    </dl>
    <h2>Use of this website</h2>
    <p>This website presents the ClickType app and its support information. Its content, design and code belong to the owner unless stated otherwise, and may not be reproduced for commercial purposes without permission. Links to third-party websites are provided for convenience; we aren’t responsible for their content.</p>
    <h2>Privacy</h2>
    <p>See the <a href={href('privacy', 'en')}>privacy policy</a>.</p>
    <h2>Applicable law</h2>
    <p>This notice is governed by Spanish law.</p>
  </Prose>
</Base>
) : (
<Base lang="es" route="legal" title="Aviso legal | ClickType" description="Datos del titular de esta web, conforme a la LSSI-CE.">
  <Prose title="Aviso legal" intro="Información sobre el titular de esta web, en cumplimiento del artículo 10 de la Ley 34/2002 (LSSI-CE).">
    <dl>
      <dt>Titular</dt><dd>{owner.legalName}</dd>
      <dt>Nombre comercial</dt><dd>{owner.brand}</dd>
      <dt>NIF</dt><dd>{owner.taxId}</dd>
      <dt>Domicilio</dt><dd>{owner.address}</dd>
      <dt>Email</dt><dd><a href={mail}>{owner.email}</a></dd>
    </dl>
    <h2>Uso de esta web</h2>
    <p>Esta web presenta la app ClickType y su información de soporte. Su contenido, diseño y código pertenecen al titular salvo que se indique lo contrario, y no pueden reproducirse con fines comerciales sin permiso. Los enlaces a webs de terceros se incluyen por comodidad; no somos responsables de su contenido.</p>
    <h2>Privacidad</h2>
    <p>Consulta la <a href={href('privacy', 'es')}>política de privacidad</a>.</p>
    <h2>Legislación aplicable</h2>
    <p>Este aviso se rige por la legislación española.</p>
  </Prose>
</Base>
)}
