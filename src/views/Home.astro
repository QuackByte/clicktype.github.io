---
import Base from '../layouts/Base.astro';
import TypingDemo from '../components/TypingDemo.astro';
import StoreButton from '../components/StoreButton.astro';
import { app } from '../config';
import { href, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
---
<Base
  lang={lang}
  route="home"
  title={es ? 'ClickType: teclea tu portapapeles con un clic, para Mac' : 'ClickType: type your clipboard with one click, for Mac'}
  description={es
    ? 'Copia texto, haz clic en el icono de ClickType en la barra de menús y lo teclea donde esté el cursor, en cualquier app del Mac.'
    : 'Copy text, click the ClickType icon in the menu bar, and it types it wherever your cursor is, in any app on your Mac.'}
>
  <section class="hero">
    <div>
      <h1>{es ? 'Copia. Haz clic. ClickType lo escribe.' : 'Copy. Click. ClickType types it.'}</h1>
      <p class="lede">
        {es
          ? 'Un clic en el icono de la barra de menús y ClickType teclea lo que tengas en el portapapeles, tecla a tecla, donde esté el cursor.'
          : 'One click on the menu bar icon, and ClickType types whatever’s on your clipboard, key by key, wherever your cursor is.'}
      </p>
      <StoreButton lang={lang} />
      <p class="meta">{es ? `Para macOS ${app.minMacOS} o posterior.` : `For macOS ${app.minMacOS} or later.`}</p>
    </div>
    <TypingDemo lang={lang} />
  </section>

  <section class="band" aria-labelledby="how">
    <h2 id="how">{es ? 'Cómo funciona' : 'How it works'}</h2>
    <ol class="steps">
      <li>
        <h3>{es ? 'Copia el texto' : 'Copy some text'}</h3>
        <p>{es ? 'Cópialo como siempre, con ⌘C o desde el menú Edición. Sirve cualquier texto.' : 'Copy it as usual, with ⌘C or from the Edit menu. Any plain text works.'}</p>
      </li>
      <li>
        <h3>{es ? 'Haz clic en el icono' : 'Click the icon'}</h3>
        <p>{es ? 'Coloca el cursor donde debe ir el texto y haz clic en la tecla de ClickType en la barra de menús.' : 'Put the cursor where the text should go, then click the ClickType keycap in the menu bar.'}</p>
      </li>
      <li>
        <h3>{es ? 'Se escribe solo' : 'It’s typed for you'}</h3>
        <p>{es ? 'ClickType envía el texto como pulsaciones de teclado, como si lo escribieras tú.' : 'ClickType sends the text as keystrokes, as if you were typing it yourself.'}</p>
      </li>
    </ol>
  </section>

  <section class="band" aria-labelledby="why">
    <h2 id="why">{es ? 'Tecleado, no pegado' : 'Typed, not pasted'}</h2>
    <div class="points">
      <div>
        <h3>{es ? 'Funciona donde pegar no' : 'Works where paste doesn’t'}</h3>
        <p>{es
          ? 'Algunos formularios, escritorios remotos y consolas de máquinas virtuales bloquean o ignoran el pegado. Las pulsaciones sí llegan.'
          : 'Some forms, remote desktops and virtual machine consoles block or ignore paste. Keystrokes get through.'}</p>
      </div>
      <div>
        <h3>{es ? 'No toca tu portapapeles' : 'Leaves your clipboard alone'}</h3>
        <p>{es ? 'Lo que hayas copiado sigue ahí después de que ClickType escriba.' : 'Whatever you copied is still there after ClickType types.'}</p>
      </div>
      <div>
        <h3>{es ? 'Se queda en tu Mac' : 'Stays on your Mac'}</h3>
        <p>
          {es ? 'ClickType lee el portapapeles solo cuando haces clic en el icono y no guarda ninguna copia. No recopila ni envía datos. ' : 'ClickType reads the clipboard only when you click its icon, and keeps no copy. It doesn’t collect or send any data. '}
          <a href={href('privacy', lang)}>{es ? 'Política de privacidad' : 'Privacy policy'}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
