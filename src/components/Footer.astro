---
import { owner } from '../config';
import { href, ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].footer;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <p>
    <a href={owner.brandUrl}>{t.madeBy}</a>
    <span class="muted">© {year} {owner.brand}</span>
  </p>
  <ul>
    <li><a href={href('privacy', lang)}>{t.privacy}</a></li>
    <li><a href={href('support', lang)}>{t.support}</a></li>
    <li><a href={href('legal', lang)}>{t.legal}</a></li>
  </ul>
</footer>
